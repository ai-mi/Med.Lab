{
  "info": {
    "name": "Med Labs API",
    "_postman_id": "c5f9a9b2-1234-4567-890a-abcdef123456",
    "description": "CRUD + Query endpoints for Med Labs Event Sourcing API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Add Laboratory Result",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"PatientId\": \"{{PatientId}}\",\n  \"TestType\": \"HbA1c\",\n  \"Result\": 5.8,\n  \"NormalMin\": 4.0,\n  \"NormalMax\": 6.0,\n  \"Comment\": \"Initial test\",\n  \"ResultId\": \"{{ResultId}}\"\n}"
        },
        "url": {
          "raw": "{{BaseUrl}}/labs",
          "host": ["{{BaseUrl}}"],
          "path": ["labs"]
        }
      },
      "response": []
    },
    {
      "name": "Update Laboratory Result",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"PatientId\": \"{{PatientId}}\",\n  \"TestType\": \"HbA1c\",\n  \"Result\": 6.2,\n  \"NormalMin\": 4.0,\n  \"NormalMax\": 6.0,\n  \"Comment\": \"Follow-up test\"\n}"
        },
        "url": {
          "raw": "{{BaseUrl}}/labs/{{ResultId}}",
          "host": ["{{BaseUrl}}"],
          "path": ["labs", "{{ResultId}}"]
        }
      },
      "response": []
    },
    {
      "name": "Delete Laboratory Result",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{BaseUrl}}/labs/{{ResultId}}?patientId={{PatientId}}",
          "host": ["{{BaseUrl}}"],
          "path": ["labs", "{{ResultId}}"],
          "query": [
            { "key": "patientId", "value": "{{PatientId}}" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get All Laboratory Results",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{BaseUrl}}/labs/{{PatientId}}",
          "host": ["{{BaseUrl}}"],
          "path": ["labs", "{{PatientId}}"]
        }
      },
      "response": []
    },
    {
      "name": "Query by TestType",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{BaseUrl}}/labs/{{PatientId}}?testType=HbA1c",
          "host": ["{{BaseUrl}}"],
          "path": ["labs", "{{PatientId}}"],
          "query": [
            { "key": "testType", "value": "HbA1c" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Query by Date Range",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{BaseUrl}}/labs/{{PatientId}}?from=2025-12-01T00:00:00Z&to=2025-12-31T23:59:59Z",
          "host": ["{{BaseUrl}}"],
          "path": ["labs", "{{PatientId}}"],
          "query": [
            { "key": "from", "value": "2025-12-01T00:00:00Z" },
            { "key": "to", "value": "2025-12-31T23:59:59Z" }
          ]
        }
      },
      "response": []
    }
  ],
